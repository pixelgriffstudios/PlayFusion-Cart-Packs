#!/usr/bin/env bash
set -Eeuo pipefail

readonly PROFILE_IDS=' default profile-1 profile-2 profile-3 '

home_dir() {
    if [[ -n "${PLAYFUSION_HOME:-}" ]]; then
        printf '%s\n' "$PLAYFUSION_HOME"
        return
    fi
    if [[ -n "${HOME:-}" && "$HOME" != /root ]]; then
        printf '%s\n' "$HOME"
    else
        getent passwd gamer | cut -d: -f6
    fi
}

HOME_DIR=$(home_dir)
[[ -n "$HOME_DIR" && -d "$HOME_DIR" ]] || { echo 'Could not locate gamer home' >&2; exit 1; }
DATA_ROOT="$HOME_DIR/.local/share/playfusion-cart-packs"
SLOT_ROOT="$DATA_ROOT/slots"
KAZETA_ROOT="$HOME_DIR/.local/share/kazeta"
SAVES_ROOT="$KAZETA_ROOT/saves"
PLUS_ROOT="$HOME_DIR/.local/share/kazeta-plus"
ACTIVE_FILE="$DATA_ROOT/active-profile"
LOCK_FILE="$DATA_ROOT/profile.lock"
EDITION_FILE="${PLAYFUSION_STATE_ROOT:-/var/lib/playfusion-cart-packs}/edition"

valid_profile() { [[ "$PROFILE_IDS" == *" $1 "* ]]; }

atomic_symlink() {
    local target=$1 link=$2 temporary
    temporary="${link}.playfusion-new.$$"
    rm -f -- "$temporary"
    ln -s -- "$target" "$temporary"
    mv -Tf -- "$temporary" "$link"
}

initialize_default_saves() {
    mkdir -p "$SLOT_ROOT/default" "$SAVES_ROOT"
    if [[ -L "$SAVES_ROOT/default" ]]; then
        case "$(readlink -f -- "$SAVES_ROOT/default")" in
            "$SLOT_ROOT"/*/saves) return 0 ;;
            *) echo 'Refusing to replace an unknown saves/default symlink' >&2; return 1 ;;
        esac
    fi
    if [[ ! -e "$SLOT_ROOT/default/saves" ]]; then
        if [[ -d "$SAVES_ROOT/default" ]]; then
            mv -- "$SAVES_ROOT/default" "$SLOT_ROOT/default/saves"
        elif [[ -e "$SAVES_ROOT/default" ]]; then
            echo 'saves/default is not a directory' >&2
            return 1
        else
            mkdir -p "$SLOT_ROOT/default/saves"
        fi
    elif [[ -d "$SAVES_ROOT/default" ]]; then
        [[ -z "$(find "$SAVES_ROOT/default" -mindepth 1 -print -quit)" ]] || {
            echo 'Both original and profile Default saves contain data; refusing to merge automatically' >&2
            return 1
        }
        rmdir "$SAVES_ROOT/default"
    fi
    atomic_symlink "$SLOT_ROOT/default/saves" "$SAVES_ROOT/default"
}

initialize_plus_config() {
    [[ "$(cat "$EDITION_FILE" 2>/dev/null || true)" == kazetaplus ]] || return 0
    mkdir -p "$PLUS_ROOT" "$SLOT_ROOT/default"
    if [[ -L "$PLUS_ROOT/config.toml" ]]; then
        case "$(readlink -f -- "$PLUS_ROOT/config.toml")" in
            "$SLOT_ROOT"/*/kazeta-plus-config.toml) return 0 ;;
            *) echo 'Refusing to replace an unknown Kazeta+ config symlink' >&2; return 1 ;;
        esac
    fi
    if [[ ! -e "$SLOT_ROOT/default/kazeta-plus-config.toml" ]]; then
        if [[ -f "$PLUS_ROOT/config.toml" ]]; then
            mv -- "$PLUS_ROOT/config.toml" "$SLOT_ROOT/default/kazeta-plus-config.toml"
        elif [[ -e "$PLUS_ROOT/config.toml" ]]; then
            echo 'Kazeta+ config path is not a regular file' >&2
            return 1
        else
            : > "$SLOT_ROOT/default/kazeta-plus-config.toml"
        fi
    elif [[ -f "$PLUS_ROOT/config.toml" ]]; then
        cmp -s "$PLUS_ROOT/config.toml" "$SLOT_ROOT/default/kazeta-plus-config.toml" || {
            echo 'Both original and profile Kazeta+ settings exist; refusing to overwrite either' >&2
            return 1
        }
        rm -f "$PLUS_ROOT/config.toml"
    fi
    atomic_symlink "$SLOT_ROOT/default/kazeta-plus-config.toml" "$PLUS_ROOT/config.toml"
}

apply_profile() {
    local id=$1
    valid_profile "$id" || { echo "Invalid profile ID: $id" >&2; return 1; }
    mkdir -p "$DATA_ROOT" "$SLOT_ROOT/$id/saves"
    initialize_default_saves
    atomic_symlink "$SLOT_ROOT/$id/saves" "$SAVES_ROOT/default"
    if [[ "$(cat "$EDITION_FILE" 2>/dev/null || true)" == kazetaplus ]]; then
        initialize_plus_config
        [[ -e "$SLOT_ROOT/$id/kazeta-plus-config.toml" ]] ||
            cp -a -- "$SLOT_ROOT/default/kazeta-plus-config.toml" "$SLOT_ROOT/$id/kazeta-plus-config.toml"
        atomic_symlink "$SLOT_ROOT/$id/kazeta-plus-config.toml" "$PLUS_ROOT/config.toml"
    fi
    printf '%s\n' "$id" > "$ACTIVE_FILE.tmp"
    mv -f "$ACTIVE_FILE.tmp" "$ACTIVE_FILE"
    printf '%s\n' "$id" > "$KAZETA_ROOT/active-profile.tmp"
    mv -f "$KAZETA_ROOT/active-profile.tmp" "$KAZETA_ROOT/active-profile"
}

restore_default() {
    mkdir -p "$DATA_ROOT"
    initialize_default_saves
    if [[ -L "$SAVES_ROOT/default" ]]; then rm -f "$SAVES_ROOT/default"; fi
    if [[ -d "$SLOT_ROOT/default/saves" ]]; then mv -- "$SLOT_ROOT/default/saves" "$SAVES_ROOT/default"; else mkdir -p "$SAVES_ROOT/default"; fi
    if [[ -L "$PLUS_ROOT/config.toml" ]]; then rm -f "$PLUS_ROOT/config.toml"; fi
    if [[ -f "$SLOT_ROOT/default/kazeta-plus-config.toml" ]]; then
        mv -- "$SLOT_ROOT/default/kazeta-plus-config.toml" "$PLUS_ROOT/config.toml"
    fi
    printf 'default\n' > "$ACTIVE_FILE"
    printf 'default\n' > "$KAZETA_ROOT/active-profile"
}

mkdir -p "$DATA_ROOT"
exec 9>"$LOCK_FILE"
flock -x 9

case "${1:-}" in
    --apply) [[ $# -eq 2 ]] || exit 2; apply_profile "$2" ;;
    --apply-active)
        id=$(tr -d '\r\n' < "$ACTIVE_FILE" 2>/dev/null || printf default)
        valid_profile "$id" || id=default
        apply_profile "$id"
        ;;
    --restore) restore_default ;;
    *) echo "Usage: $0 {--apply ID|--apply-active|--restore}" >&2; exit 2 ;;
esac
