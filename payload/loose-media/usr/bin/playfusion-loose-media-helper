#!/usr/bin/env bash
set -Eeuo pipefail

VISIBLE_CART=${PLAYFUSION_VISIBLE_CART:-/run/media/playfusion-loose-rom}
CACHE_ROOT=${PLAYFUSION_ROM_CACHE:-/var/cache/playfusion-cart-packs/roms}
STATE_DIR=${PLAYFUSION_ROM_STATE:-/run/playfusion-cart-packs/loose-media}
RUNTIME_ROOT=${PLAYFUSION_RUNTIME_ROOT:-/usr/share/kazeta/runtimes}
UNKNOWN_ICON=${PLAYFUSION_UNKNOWN_ICON:-/usr/share/playfusion-cart-packs/unknown.png}
LOCK_FILE=${PLAYFUSION_ROM_LOCK:-/run/lock/playfusion-loose-media.lock}
COVER_BASE=https://raw.githubusercontent.com/libretro-thumbnails
MULTI_MARKER=${PLAYFUSION_MULTI_MARKER:-/usr/lib/playfusion-cart-packs/features/multi-rom}

log() {
    logger -t playfusion-loose-media -- "$*" 2>/dev/null || true
    printf '%s\n' "$*"
}

safe_unmount() {
    if mountpoint -q "$VISIBLE_CART"; then
        umount -- "$VISIBLE_CART"
    fi
    rmdir -- "$VISIBLE_CART" 2>/dev/null || true
}

remove_virtual_cart() {
    safe_unmount
    rm -rf -- "$STATE_DIR"
}

read_hex() {
    local file=$1 offset=$2 count=$3
    dd if="$file" bs=1 skip="$offset" count="$count" status=none 2>/dev/null |
        od -An -tx1 -v | tr -d '[:space:]'
}

probe_iso() {
    local file=$1 mount_dir result=''
    [[ "$(read_hex "$file" 24 4)" != 5d1c9ea3 ]] || { printf 'wii\tdolphin-1.0\n'; return; }
    [[ "$(read_hex "$file" 28 4)" != c2339f3d ]] || { printf 'gamecube\tdolphin-1.0\n'; return; }
    mount_dir=$(mktemp -d)
    if mount -o loop,ro,nosuid,nodev,noexec -- "$file" "$mount_dir" 2>/dev/null; then
        if [[ -d "$mount_dir/PSP_GAME" ]]; then
            result=$'psp\tpsp-1.0'
        elif find "$mount_dir" -maxdepth 2 -type f -iname 'SYSTEM.CNF*' -exec grep -Eiq '^[[:space:]]*BOOT2[[:space:]]*=' {} \; -print -quit 2>/dev/null | grep -q .; then
            result=$'ps2\tplaystation2-1.0'
        fi
        umount -- "$mount_dir"
    fi
    rmdir -- "$mount_dir"
    [[ -n "$result" ]] || return 1
    printf '%s\n' "$result"
}

probe_bin() {
    local file=$1 magic header signature payload
    magic=$(read_hex "$file" 0 4)
    case "$magic" in
        4e45531a) printf 'nes\tnes-1.0\n'; return ;;
        80371240|40123780|37804012) printf 'nintendo64\tnintendo64-1.0\n'; return ;;
        4c594e58) printf 'atarilynx\tatarilynx-1.0\n'; return ;;
    esac
    for payload in 0 16 24; do
        signature=$(dd if="$file" bs=1 skip="$payload" count=32 status=none 2>/dev/null | tr -d '\000\r\n')
        case "$signature" in
            'SEGA SEGASATURN'*) printf 'saturn\tsaturn-1.0\n'; return ;;
            SEGADISCSYSTEM*) printf 'segacd\tsegacd-1.0\n'; return ;;
            'SEGA SEGAKATANA'*) printf 'dreamcast\tdreamcast-1.0\n'; return ;;
        esac
    done
    header=$(dd if="$file" bs=1 skip=256 count=16 status=none 2>/dev/null | tr -d '\000\r\n')
    case "$header" in
        'SEGA 32X'*) printf 'sega32x\tsega32x-1.0\n'; return ;;
        SEGA*) printf 'megadrive\tmegadrive-1.1\n'; return ;;
    esac
    signature=$(dd if="$file" bs=1 skip=1 count=8 status=none 2>/dev/null | tr -d '\000\r\n')
    [[ "$signature" != ATARI7800 ]] || { printf 'atari7800\tatari7800-1.0\n'; return; }
    return 1
}

probe_cue() {
    local cue=$1 parent data_name data_file payload signature
    parent=$(dirname -- "$cue")
    data_name=$(sed -n -E 's/^[[:space:]]*FILE[[:space:]]+"([^"]+)"[[:space:]]+BINARY.*/\1/Ip' "$cue" | head -n 1)
    [[ -n "$data_name" ]] || return 1
    data_file=$(realpath -e -- "$parent/$data_name" 2>/dev/null || true)
    [[ -f "$data_file" ]] || return 1
    case "$data_file" in "$parent"/*) ;; *) return 1 ;; esac
    if grep -Eiq '^[[:space:]]*TRACK[[:space:]]+[0-9]+[[:space:]]+MODE2/2352' "$cue"; then payload=24; else payload=16; fi
    signature=$(dd if="$data_file" bs=1 skip="$payload" count=32 status=none 2>/dev/null | tr -d '\000\r\n')
    case "$signature" in
        'SEGA SEGASATURN'*) printf 'saturn\tsaturn-1.0\n' ;;
        SEGADISCSYSTEM*) printf 'segacd\tsegacd-1.0\n' ;;
        'SEGA SEGAKATANA'*) printf 'dreamcast\tdreamcast-1.0\n' ;;
        *) printf 'ps1\tplaystation-1.01\n' ;;
    esac
}

probe_extension() {
    local file=$1 name extension magic
    name=${2:-$(basename -- "$file")}
    extension=${name##*.}; extension=${extension,,}
    case "$extension" in
        nes) [[ -n "${2:-}" || "$(read_hex "$file" 0 4)" == 4e45531a ]] && printf 'nes\tnes-1.0\n' ;;
        sfc|smc) printf 'snes\tsnes-1.0\n' ;;
        gb) printf 'gameboy\tgameboy-1.0\n' ;;
        gbc) printf 'gameboycolor\tgameboycolor-1.0\n' ;;
        gba) printf 'gameboyadvance\tgameboyadvance-1.0\n' ;;
        nds) printf 'nintendods\tnintendods-1.0\n' ;;
        3ds|cci|cxi)
            if [[ -z "${2:-}" ]]; then
                magic=$(dd if="$file" bs=1 skip=256 count=4 status=none 2>/dev/null | tr -d '\000\r\n')
                [[ "$magic" == NCSD || "$magic" == NCCH ]] || return 1
            fi
            printf 'nintendo3ds\tnintendo3ds-1.0\n'
            ;;
        z64|n64|v64) printf 'nintendo64\tnintendo64-1.0\n' ;;
        sms) printf 'mastersystem\tmastersystem-1.0\n' ;;
        gg) printf 'gamegear\tgamegear-1.0\n' ;;
        md|gen) printf 'megadrive\tmegadrive-1.1\n' ;;
        32x) printf 'sega32x\tsega32x-1.0\n' ;;
        pce) printf 'pcengine\tpcengine-1.0\n' ;;
        a26) printf 'atari2600\tatari2600-1.0\n' ;;
        a78) printf 'atari7800\tatari7800-1.0\n' ;;
        lnx) printf 'atarilynx\tatarilynx-1.0\n' ;;
        jag|j64) printf 'jaguar\tjaguar-1.0\n' ;;
        d64|t64|prg) printf 'commodore64\tcommodore64-1.0\n' ;;
        adf|adz) printf 'amiga\tamiga-1.0\n' ;;
        cdi|gdi) printf 'dreamcast\tdreamcast-1.0\n' ;;
        wbfs) printf 'wii\tdolphin-1.0\n' ;;
        gcm|rvz) printf 'gamecube\tdolphin-1.0\n' ;;
        wux|wud) printf 'wiiu\tcemu-1.0\n' ;;
        cso) printf 'psp\tpsp-1.0\n' ;;
        bin) [[ -z "${2:-}" ]] && probe_bin "$file" ;;
        cue) [[ -z "${2:-}" ]] && probe_cue "$file" ;;
        iso) [[ -z "${2:-}" ]] && probe_iso "$file" ;;
        zip)
            [[ -z "${2:-}" ]] || return 1
            command -v unzip >/dev/null 2>&1 || return 1
            mapfile -t entries < <(unzip -Z1 "$file" 2>/dev/null | sed '/\/$/d; /__MACOSX/d; /\.DS_Store/d')
            [[ ${#entries[@]} -eq 1 ]] || return 1
            probe_extension "$file" "${entries[0]}"
            ;;
        *) return 1 ;;
    esac
}

candidate_roots() {
    local root
    if [[ -n "${PLAYFUSION_TEST_ROOTS:-}" ]]; then
        tr ':' '\n' <<< "$PLAYFUSION_TEST_ROOTS" | while IFS= read -r root; do [[ -d "$root" ]] && printf '%s\0' "$root"; done
        return
    fi
    for root in /run/media/* /run/media/*/* /media/*; do
        [[ -d "$root" ]] || continue
        case "$root" in "$VISIBLE_CART"|/run/media/kazeta-optical|/run/media/kazeta-optical/*) continue ;; esac
        mountpoint -q "$root" || continue
        # A real Kazeta cartridge always wins. Never reinterpret its payload as
        # loose media, especially for PC carts that may contain ROM-like files.
        find "$root" -maxdepth 2 -type f -name '*.kzi' -print -quit 2>/dev/null | grep -q . && continue
        printf '%s\0' "$root"
    done
}

is_companion_track() {
    local file=$1 parent name descriptor
    [[ "${file,,}" == *.bin ]] || return 1
    parent=$(dirname -- "$file")
    name=$(basename -- "$file")
    while IFS= read -r -d '' descriptor; do
        grep -Fqi -- "$name" "$descriptor" 2>/dev/null && return 0
    done < <(find "$parent" -maxdepth 1 -type f \( -iname '*.cue' -o -iname '*.gdi' \) -print0 2>/dev/null)
    return 1
}

find_roms() {
    local root file probe platform runtime relative count=0
    while IFS= read -r -d '' root; do
        while IFS= read -r -d '' file; do
            [[ "$file" != *$'\t'* && "$file" != *$'\n'* ]] || continue
            is_companion_track "$file" && continue
            probe=$(probe_extension "$file" 2>/dev/null || true)
            [[ -n "$probe" ]] || continue
            IFS=$'\t' read -r platform runtime <<< "$probe"
            relative=${file#"$root"/}
            printf '%s\t%s\t%s\t%s\t%s\n' "$file" "$root" "$platform" "$runtime" "$relative"
            count=$((count + 1))
        done < <(
            find "$root" -maxdepth 6 \
                \( -type d \( -iname runtimes -o -iname firmware -o -iname bios -o -iname lost+found -o -iname '$RECYCLE.BIN' -o -iname 'System Volume Information' \) -prune \) -o \
                \( -type f -readable -size +0c -size -128G ! -path '*/.*' -print0 \) 2>/dev/null
        )
    done < <(candidate_roots)
    [[ $count -gt 0 ]]
}

resolve_runtime() {
    local runtime=$1 media_root=$2 candidate
    for candidate in "$RUNTIME_ROOT/$runtime" "$RUNTIME_ROOT/$runtime.kzr" "$RUNTIME_ROOT/$runtime-"*.kzr; do
        [[ -f "$candidate" ]] && { printf 'internal\t%s\n' "$candidate"; return; }
    done
    for candidate in "$media_root/$runtime" "$media_root/$runtime.kzr" "$media_root/$runtime-"*.kzr; do
        [[ -f "$candidate" ]] && { printf 'media\t%s\n' "$candidate"; return; }
    done
    return 1
}

slugify() {
    printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//' | cut -c1-40
}

cover_repository() {
    case "$1" in
        nes) printf Nintendo_-_Nintendo_Entertainment_System ;;
        snes) printf Nintendo_-_Super_Nintendo_Entertainment_System ;;
        gameboy) printf Nintendo_-_Game_Boy ;;
        gameboycolor) printf Nintendo_-_Game_Boy_Color ;;
        gameboyadvance) printf Nintendo_-_Game_Boy_Advance ;;
        nintendods) printf Nintendo_-_Nintendo_DS ;;
        nintendo3ds) printf Nintendo_-_Nintendo_3DS ;;
        nintendo64) printf Nintendo_-_Nintendo_64 ;;
        mastersystem) printf Sega_-_Master_System_-_Mark_III ;;
        gamegear) printf Sega_-_Game_Gear ;;
        megadrive) printf Sega_-_Mega_Drive_-_Genesis ;;
        sega32x) printf Sega_-_32X ;;
        pcengine) printf NEC_-_PC_Engine_-_TurboGrafx_16 ;;
        atari2600) printf Atari_-_2600 ;;
        atari7800) printf Atari_-_7800 ;;
        atarilynx) printf Atari_-_Lynx ;;
        jaguar) printf Atari_-_Jaguar ;;
        psp) printf Sony_-_PlayStation_Portable ;;
        ps1) printf Sony_-_PlayStation ;;
        ps2) printf Sony_-_PlayStation_2 ;;
        wii) printf Nintendo_-_Wii ;;
        gamecube) printf Nintendo_-_GameCube ;;
        wiiu) printf Nintendo_-_Wii_U ;;
        dreamcast) printf Sega_-_Dreamcast ;;
        saturn) printf Sega_-_Saturn ;;
        segacd) printf Sega_-_Mega-CD_-_Sega_CD ;;
        *) return 1 ;;
    esac
}

urlencode() {
    local value=$1 output='' char hex i
    LC_ALL=C
    for ((i=0; i<${#value}; i++)); do
        char=${value:i:1}
        case "$char" in
            [a-zA-Z0-9.~_-]) output+=$char ;;
            ' ') output+='%20' ;;
            *) printf -v hex '%%%02X' "'$char"; output+=$hex ;;
        esac
    done
    printf '%s\n' "$output"
}

download_cover() {
    local cart_dir=$1 platform=$2 title=$3 repository candidate encoded temporary signature
    repository=$(cover_repository "$platform") || return 1
    temporary="$cart_dir/.cover.part.$$"
    rm -f -- "$temporary"
    while IFS= read -r candidate; do
        [[ -n "$candidate" ]] || continue
        encoded=$(urlencode "$candidate")
        if curl -fsSL --connect-timeout 3 --max-time 10 \
            "$COVER_BASE/$repository/master/Named_Boxarts/$encoded.png" \
            -o "$temporary"; then
            signature=$(head -c 8 "$temporary" | od -An -tx1 -v | tr -d '[:space:]')
            [[ "$signature" == 89504e470d0a1a0a ]] && break
        fi
        rm -f -- "$temporary"
    done < <(
        printf '%s\n' "$title"
        printf '%s\n' "$title" | sed -E 's/[[:space:]]+\((En|Ja|Fr|Es|De|It|Nl|Pt)(,[A-Z][a-z])*(,[A-Z][a-z])?\)//g'
        printf '%s\n' "$title" | sed -E 's/[[:space:]]+\([^()]*\)$//'
        printf '%s\n' "$title" | sed -E 's/([[:space:]]+\([^()]*\))+$//'
    )
    [[ -s "$temporary" ]] || return 1
    mv -f -- "$temporary" "$cart_dir/cover.png"
    cp -f -- "$cart_dir/cover.png" "$cart_dir/icon.png"
    grep -q '^Cover=' "$cart_dir/cart.kzi" || printf 'Cover=cover.png\n' >> "$cart_dir/cart.kzi"
    rm -f -- "$cart_dir/.cover-query"
    chmod 644 "$cart_dir/cover.png" "$cart_dir/icon.png" "$cart_dir/cart.kzi"
}

download_pending_covers() {
    local query cart_dir platform title
    while IFS= read -r -d '' query; do
        cart_dir=$(dirname -- "$query")
        IFS=$'\t' read -r platform title < "$query" || continue
        download_cover "$cart_dir" "$platform" "$title" || true
    done < <(find "$CACHE_ROOT" -type f -name .cover-query -print0 2>/dev/null)
}

schedule_covers() {
    find "$CACHE_ROOT" -type f -name .cover-query -print -quit 2>/dev/null | grep -q . || return 0
    systemctl start --no-block playfusion-loose-media-covers.service >/dev/null 2>&1 || true
}

copy_unknown_icon() {
    local destination=$1
    if [[ -s "$UNKNOWN_ICON" ]]; then cp -f -- "$UNKNOWN_ICON" "$destination"; else printf '\x89PNG\r\n\x1a\n' > "$destination"; fi
}

create_cart() {
    local source=$1 media_root=$2 platform=$3 runtime=$4 relative=$5 destination_root=$6 default=${7:-false}
    local filename stem slug size digest cart_id cart_dir runtime_info runtime_kind runtime_path art extension cover=''
    filename=$(basename -- "$source")
    stem=${filename%.*}
    slug=$(slugify "$stem"); [[ -n "$slug" ]] || slug=game
    size=$(stat -c %s -- "$source")
    digest=$(
        {
            printf '%s\0%s\0%s\0' "$platform" "${filename,,}" "$size"
            head -c 65536 -- "$source" 2>/dev/null || true
            tail -c 65536 -- "$source" 2>/dev/null || true
        } | sha256sum | cut -c1-16
    )
    cart_id="loose-$platform-$slug-$digest"
    cart_dir="$destination_root/$cart_id"
    runtime_info=$(resolve_runtime "$runtime" "$media_root" 2>/dev/null || true)
    [[ -n "$runtime_info" ]] || { log "Skipping $relative: runtime $runtime.kzr is missing"; return 1; }
    IFS=$'\t' read -r runtime_kind runtime_path <<< "$runtime_info"

    rm -rf -- "$cart_dir"
    mkdir -p "$cart_dir"
    ln -s -- "$(dirname -- "$source")" "$cart_dir/game"
    if [[ "$runtime_kind" == media ]]; then ln -s -- "$runtime_path" "$cart_dir/$runtime.kzr"; fi
    copy_unknown_icon "$cart_dir/icon.png"
    for extension in png jpg jpeg; do
        art="$(dirname -- "$source")/$stem.$extension"
        if [[ -s "$art" ]]; then
            ln -s -- "$art" "$cart_dir/cover.$extension"
            cover="cover.$extension"
            break
        fi
    done
    if [[ -z "$cover" ]]; then printf '%s\t%s\n' "$platform" "$stem" > "$cart_dir/.cover-query"; fi
    printf '%s\n' "$source" > "$cart_dir/.source"
    printf '%s\n' "$media_root" > "$cart_dir/.media-root"
    cat > "$cart_dir/cart.kzi" <<EOF
[Desktop Entry]
Name=$stem
Id=$cart_id
Exec=game/$filename
Icon=icon.png
Runtime=$runtime
Platform=$platform
SourceFile=$relative
GamescopeOptions=$(case "$platform" in nintendo64|wii|gamecube|wiiu|ps2|psp) printf '%s' '--filter linear' ;; *) printf '%s' '--filter pixel' ;; esac)
EOF
    [[ "$default" != true ]] || printf 'SetAsDefaultGame=true\n' >> "$cart_dir/cart.kzi"
    [[ -z "$cover" ]] || printf 'Cover=%s\n' "$cover" >> "$cart_dir/cart.kzi"
    chmod -R a+rX "$cart_dir"
    CREATED_ID=$cart_id
    CREATED_DIR=$cart_dir
}

publish_bind() {
    local source=$1
    safe_unmount
    mkdir -p "$VISIBLE_CART"
    mount --bind "$source" "$VISIBLE_CART"
    mount -o remount,bind,ro "$VISIBLE_CART"
}

publish_single() {
    local line=$1 file root platform runtime relative single="$CACHE_ROOT/single"
    IFS=$'\t' read -r file root platform runtime relative <<< "$line"
    rm -rf -- "$single"; mkdir -p "$single"
    create_cart "$file" "$root" "$platform" "$runtime" "$relative" "$single" true
    publish_bind "$CREATED_DIR"
    mkdir -p "$STATE_DIR"
    printf '1\n' > "$STATE_DIR/count"
    printf '%s\n' "$CREATED_ID" > "$STATE_DIR/selected"
}

publish_collection() {
    local manifest=$1 collection="$CACHE_ROOT/collection" file root platform runtime relative created=0
    rm -rf -- "$collection"; mkdir -p "$collection"
    while IFS=$'\t' read -r file root platform runtime relative; do
        [[ -r "$file" ]] || continue
        if create_cart "$file" "$root" "$platform" "$runtime" "$relative" "$collection" false; then created=$((created + 1)); fi
    done <<< "$manifest"
    [[ $created -gt 0 ]] || return 1
    printf '%s\n' "$manifest" > "$collection/.manifest"
    publish_bind "$collection"
    mkdir -p "$STATE_DIR"
    printf '%s\n' "$created" > "$STATE_DIR/count"
    rm -f "$STATE_DIR/selected"
}

scan_media() {
    local manifest count prior
    manifest=$(find_roms || true)
    if [[ -z "$manifest" ]]; then remove_virtual_cart; return 1; fi
    prior=$(cat "$STATE_DIR/manifest" 2>/dev/null || true)
    if [[ "$manifest" == "$prior" ]] && mountpoint -q "$VISIBLE_CART"; then return 0; fi
    count=$(printf '%s\n' "$manifest" | sed '/^[[:space:]]*$/d' | wc -l)
    mkdir -p "$CACHE_ROOT" "$STATE_DIR"
    if [[ $count -eq 1 ]]; then
        publish_single "$manifest"
    elif [[ -e "$MULTI_MARKER" ]]; then
        publish_collection "$manifest"
    else
        remove_virtual_cart
        log "$count ROMs found; install Multi-ROM Browser to select between them"
        return 0
    fi
    printf '%s\n' "$manifest" > "$STATE_DIR/manifest"
    schedule_covers
    log "$count removable ROM(s) published as read-only virtual cart metadata"
}

settle_media() {
    local attempt
    for attempt in $(seq 1 20); do scan_media && return 0; sleep 0.25; done
    return 0
}

select_cart() {
    local id=$1 cart source media_root
    cart="$CACHE_ROOT/collection/$id"
    [[ "$id" =~ ^loose-[a-z0-9-]+$ ]] || { log 'Invalid virtual cart ID'; return 1; }
    [[ -f "$cart/cart.kzi" && -r "$cart/.source" && -r "$cart/.media-root" ]] || return 1
    source=$(cat "$cart/.source"); media_root=$(cat "$cart/.media-root")
    [[ -r "$source" && -d "$media_root" ]] || return 1
    case "$(realpath -e -- "$source")" in "$(realpath -e -- "$media_root")"/*) ;; *) return 1 ;; esac
    publish_bind "$cart"
    printf '%s\n' "$id" > "$STATE_DIR/selected"
}

mkdir -p "$(dirname -- "$LOCK_FILE")"
exec 9>"$LOCK_FILE"
flock -x 9

case "${1:-}" in
    scan) scan_media ;;
    settle) settle_media ;;
    remove) remove_virtual_cart ;;
    select) [[ $# -eq 2 ]] || exit 2; select_cart "$2" ;;
    probe) [[ $# -eq 2 ]] || exit 2; probe_extension "$2" ;;
    list) find_roms ;;
    covers) download_pending_covers ;;
    *) echo "Usage: $0 {scan|settle|remove|select ID|probe FILE|list}" >&2; exit 2 ;;
esac
